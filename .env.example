# Copy to .env and fill in only what you use: cp .env.example .env
# goa reads ./.env on start; variables already set in your shell win.

# Defaults for --llm and --decision (provider[:model]). Leave them out and `auto` picks:
# a Claude or ChatGPT sign-in (goa login claude | goa login codex), then the first key below, then offline.
GOA_LLM=openrouter
GOA_DECISION=openrouter

# Sign-ins: no key here; the official CLI keeps its own credentials
# GOA_CLAUDE_CODE_MODEL=sonnet          # --llm claude-code (Claude Code: claude -p)
# GOA_CODEX_MODEL=gpt-5.5               # --llm codex (Codex CLI: codex exec); default: your Codex config
# GOA_CODEX_EFFORT=low                  # reasoning effort for codex; empty for the Codex default

# OpenRouter: one key for both the LLM and the decision model
OPENROUTER_API_KEY=
# GOA_OPENROUTER_MODEL=anthropic/claude-sonnet-5-5   # LLM model (default openrouter/auto)
# GOA_OPENROUTER_DECISION_MODEL=typesafe/jev-1.14   # judge model (default typesafe/jev-1.14)

# Other LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
LLAMA_API_KEY=

# Other decision models
TYPESAFE_API_KEY=
AIMLAPI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Logs: debug | info | warning
GOA_LOG=warning
