# Copy to .env and fill in only what you use: cp .env.example .env
# goa reads ./.env on start; variables already set in your shell win.

# Defaults for --llm and --decision (provider[:model])
GOA_LLM=openrouter
GOA_DECISION=openrouter

# OpenRouter: one key for both the LLM and the decision model
OPENROUTER_API_KEY=
# GOA_OPENROUTER_MODEL=anthropic/claude-sonnet-5-5   # LLM model (default openrouter/auto)
# GOA_OPENROUTER_DECISION_MODEL=typesafe/jev-1.14   # judge model (default typesafe/jev-1.14)

# Other LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
LLAMA_API_KEY=

# Other decision models
TYPESAFE_API_KEY=
AIMLAPI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Logs: debug | info | warning
GOA_LOG=warning
