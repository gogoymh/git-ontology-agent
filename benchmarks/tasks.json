  "invalidation_cases": [
    {
      "id": "inv_budget_wildcard",
      "mode": "state_invalidate",
      "initial_claims": [
        {"id": "req.1", "type": "Request", "value": "plan a Busan trip", "from": "req.1"},
        {"id": "trip.city", "type": "Assumption", "value": "Busan", "from": "req.1"},
        {"id": "plan.train", "type": "Decision", "value": "Tue 08:00 KTX", "from": "req.1", "depends_on": ["trip.city"]},
        {"id": "hotel.candidates", "type": "Finding", "value": "A, B, C", "from": "req.1", "depends_on": ["trip.city", "constraint.*"]},
        {"id": "plan.hotel", "type": "Decision", "value": "C", "from": "req.1", "depends_on": ["hotel.candidates", "constraint.*"]},
        {"id": "plan.total", "type": "Decision", "value": "600k", "from": "req.1", "depends_on": ["plan.train", "plan.hotel"]}
      ],
      "add_claims": [
        {"id": "constraint.budget", "type": "Constraint", "value": "500k", "from": "req.2"}
      ],
      "changed_ids": ["constraint.budget"],
      "expected_invalid": ["hotel.candidates", "plan.hotel", "plan.total"],
      "expected_confirmed": ["trip.city", "plan.train", "constraint.budget"]
    },
    {
      "id": "inv_city_correction",
      "mode": "state_correct",
      "initial_claims": [
        {"id": "req.1", "type": "Request", "value": "plan a Busan trip", "from": "req.1"},
        {"id": "trip.city", "type": "Assumption", "value": "Busan", "from": "req.1"},
        {"id": "constraint.budget", "type": "Constraint", "value": "500k", "from": "req.1"},
        {"id": "plan.train", "type": "Decision", "value": "Tue 08:00 KTX", "from": "req.1", "depends_on": ["trip.city"]},
        {"id": "hotel.candidates", "type": "Finding", "value": "A, B, C", "from": "req.1", "depends_on": ["trip.city", "constraint.*"]},
        {"id": "plan.hotel", "type": "Decision", "value": "A", "from": "req.1", "depends_on": ["hotel.candidates", "constraint.*"]},
        {"id": "plan.total", "type": "Decision", "value": "460k", "from": "req.1", "depends_on": ["plan.train", "plan.hotel"]}
      ],
      "correction": {"id": "trip.city", "type": "Assumption", "value": "Daegu", "from": "req.2"},
      "expected_invalid": ["plan.train", "hotel.candidates", "plan.hotel", "plan.total"],
      "expected_confirmed": ["constraint.budget", "trip.city"],
      "expected_superseded_id": "trip.city#req.1",
      "expected_prev": "Busan",
      "expected_corrects": "req.1"
    },
    {
      "id": "inv_no_dependents",
      "mode": "state_invalidate",
      "initial_claims": [
        {"id": "trip.city", "type": "Assumption", "value": "Busan", "from": "req.1"},
        {"id": "plan.train", "type": "Decision", "value": "Tue 08:00 KTX", "from": "req.1", "depends_on": ["trip.city"]}
      ],
      "add_claims": [
        {"id": "note.wifi", "type": "Constraint", "value": "free wifi", "from": "req.2"}
      ],
      "changed_ids": ["note.wifi"],
      "expected_invalid": [],
      "expected_confirmed": ["trip.city", "plan.train", "note.wifi"]
    },
    {
      "id": "inv_deep_chain",
      "mode": "state_invalidate",
      "initial_claims": [
        {"id": "node.a", "type": "Assumption", "value": "1", "from": "req.1"},
        {"id": "node.b", "type": "Finding", "value": "2", "from": "req.1", "depends_on": ["node.a"]},
        {"id": "node.c", "type": "Finding", "value": "3", "from": "req.1", "depends_on": ["node.b"]},
        {"id": "node.d", "type": "Decision", "value": "4", "from": "req.1", "depends_on": ["node.c"]},
        {"id": "node.e", "type": "Decision", "value": "5", "from": "req.1", "depends_on": ["node.d"]},
        {"id": "side.x", "type": "Decision", "value": "keep", "from": "req.1"}
      ],
      "add_claims": [],
      "changed_ids": ["node.a"],
      "expected_invalid": ["node.b", "node.c", "node.d", "node.e"],
      "expected_confirmed": ["node.a", "side.x"]
    },
    {
      "id": "inv_diamond_graph",
      "mode": "state_invalidate",
      "initial_claims": [
        {"id": "root", "type": "Assumption", "value": "v1", "from": "req.1"},
        {"id": "left", "type": "Finding", "value": "l", "from": "req.1", "depends_on": ["root"]},
        {"id": "right", "type": "Finding", "value": "r", "from": "req.1", "depends_on": ["root"]},
        {"id": "leaf", "type": "Decision", "value": "lr", "from": "req.1", "depends_on": ["left", "right"]},
        {"id": "sibling", "type": "Decision", "value": "s", "from": "req.1"}
      ],
      "add_claims": [],
      "changed_ids": ["root"],
      "expected_invalid": ["left", "right", "leaf"],
      "expected_confirmed": ["root", "sibling"]
    },
    {
      "id": "inv_cycle_guard",
      "mode": "state_invalidate",
      "initial_claims": [
        {"id": "c1", "type": "Assumption", "value": "1", "from": "req.1", "depends_on": ["c2"]},
        {"id": "c2", "type": "Decision", "value": "2", "from": "req.1", "depends_on": ["c1"]},
        {"id": "c3", "type": "Decision", "value": "3", "from": "req.1", "depends_on": ["c2"]},
        {"id": "indep", "type": "Decision", "value": "ok", "from": "req.1"}
      ],
      "add_claims": [],
      "changed_ids": ["c1"],
      "expected_invalid": ["c1", "c2", "c3"],
      "expected_confirmed": ["indep"]
    },
    {
      "id": "inv_skip_request_and_progress",
      "mode": "state_invalidate",
      "initial_claims": [
        {"id": "req.1", "type": "Request", "value": "trip", "from": "req.1", "depends_on": ["trip.city"]},
        {"id": "progress.step", "type": "Progress", "value": "working", "from": "req.1", "depends_on": ["trip.city"]},
        {"id": "trip.city", "type": "Assumption", "value": "Busan", "from": "req.1"},
        {"id": "plan.train", "type": "Decision", "value": "KTX", "from": "req.1", "depends_on": ["trip.city"]}
      ],
      "add_claims": [],
      "changed_ids": ["trip.city"],
      "expected_invalid": ["plan.train"],
      "expected_confirmed": ["req.1", "progress.step", "trip.city"]
    },
    {
      "id": "inv_wildcard_prefix_boundary",
      "mode": "state_invalidate",
      "initial_claims": [
        {"id": "trip.dates", "type": "Assumption", "value": "Tue-Thu", "from": "req.1"},
        {"id": "plan.train", "type": "Decision", "value": "KTX", "from": "req.1", "depends_on": ["trip.*"]},
        {"id": "trip2.note", "type": "Finding", "value": "note", "from": "req.1", "depends_on": ["trip2.*"]},
        {"id": "other.item", "type": "Decision", "value": "x", "from": "req.1", "depends_on": ["other.*"]}
      ],
      "add_claims": [],
      "changed_ids": ["trip.dates"],
      "expected_invalid": ["plan.train"],
      "expected_confirmed": ["trip.dates", "trip2.note", "other.item"]
    },
    {
      "id": "inv_agent_supplement_flow",
      "mode": "agent_flow",
      "lang": "en",
      "setup": [
        {"message": "Plan my Busan business trip next week", "ticks": 2}
      ],
      "followup": "Oh, keep the budget under 500,000 won",
      "branch": "req/1",
      "expected_invalid": ["hotel.candidates"],
      "expected_confirmed": ["trip.city", "plan.train", "constraint.budget"],
      "expected_after_run_confirmed": ["plan.train", "hotel.candidates", "plan.hotel", "plan.total"],
      "expected_preserved_from": {"plan.train": "req.1", "constraint.budget": "req.2"}
    },
    {
      "id": "inv_agent_correction_flow",
      "mode": "agent_flow",
      "lang": "en",
      "setup": [
        {"message": "Plan my Busan business trip next week", "ticks": 2}
      ],
      "followup": "Actually, not Busan but Daegu",
      "branch": "req/1",
      "expected_invalid": ["plan.train", "hotel.candidates"],
      "expected_confirmed": ["trip.city"],
      "expected_superseded_id": "trip.city#req.1",
      "expected_after_run_confirmed": ["trip.city", "plan.train", "hotel.candidates", "plan.hotel", "plan.total"],
      "expected_preserved_from": {"trip.city": "req.2"}
    }
  ],
